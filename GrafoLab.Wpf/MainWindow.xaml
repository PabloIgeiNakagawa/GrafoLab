<Window x:Class="GrafoLab.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conjunto dominante minimo - Editor de grafos"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <RadioButton Content="Seleccionar" Style="{StaticResource ModeRadioStyle}"
                             IsChecked="True" GroupName="Modo"
                             Checked="ModoRadio_Checked" Tag="Seleccionar" />
                <RadioButton Content="Agregar vertice" Style="{StaticResource ModeRadioStyle}"
                             GroupName="Modo"
                             Checked="ModoRadio_Checked" Tag="AgregarVertice" />
                <RadioButton Content="Agregar arista" Style="{StaticResource ModeRadioStyle}"
                             GroupName="Modo"
                             Checked="ModoRadio_Checked" Tag="AgregarArista" />
                <RadioButton Content="Mover" Style="{StaticResource ModeRadioStyle}"
                             GroupName="Modo"
                             Checked="ModoRadio_Checked" Tag="Mover" />
                <RadioButton Content="Eliminar" Style="{StaticResource ModeRadioStyle}"
                             GroupName="Modo"
                             Checked="ModoRadio_Checked" Tag="Eliminar" />

                <ComboBox ItemsSource="{Binding AlgoritmosDisponibles}"
                          SelectedItem="{Binding AlgoritmoSeleccionado}"
                          DisplayMemberPath="Nombre"
                          MinWidth="240" Margin="2" />
                <Button Content="Ejecutar" Click="BtnEjecutar_Click"
                        Style="{StaticResource BotonEstilo}" Width="80" Margin="2" />

            </WrapPanel>
        </Border>

        <!-- Banner resultado -->
        <Border Grid.Row="1" Padding="10,6" Background="#E8F5E9"
                Visibility="{Binding MostrarBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding AlgoritmoNombre}"
                           FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="14" Margin="0,0,8,0"
                                 IsIndeterminate="{Binding Ejecutando}"
                                 Visibility="{Binding Ejecutando, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Resultado}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2" Content="×" FontSize="14" FontWeight="Bold"
                        Width="24" Height="24" Padding="0" Foreground="#666"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnCerrarBanner_Click" />
            </Grid>
        </Border>

        <!-- Canvas -->
        <ScrollViewer Grid.Row="2" x:Name="scrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      Background="White">
            <Grid x:Name="editorGrid"
                  Width="4000" Height="4000"
                  MouseDown="EditorGrid_MouseDown"
                  MouseMove="EditorGrid_MouseMove"
                  MouseUp="EditorGrid_MouseUp"
                  Background="#F8F8F8">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="zoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <ItemsControl ItemsSource="{Binding AristasVisibles}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                      X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="#0086BE" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Border Canvas.Left="{Binding TextX}" Canvas.Top="{Binding TextY}"
                                        Background="White" Padding="4,2" CornerRadius="3"
                                        Visibility="{Binding TienePeso, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PesoTexto}"
                                               Foreground="#0086BE" FontWeight="Bold" FontSize="11" />
                                </Border>
                                <Line X1="{Binding ArrowTipX}" Y1="{Binding ArrowTipY}"
                                      X2="{Binding ArrowLeftX}" Y2="{Binding ArrowLeftY}"
                                      Stroke="#0086BE" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding EsDirigida, Converter={StaticResource BoolToVis}}" />
                                <Line X1="{Binding ArrowTipX}" Y1="{Binding ArrowTipY}"
                                      X2="{Binding ArrowRightX}" Y2="{Binding ArrowRightY}"
                                      Stroke="#0086BE" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding EsDirigida, Converter={StaticResource BoolToVis}}" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="verticesControl" ItemsSource="{Binding VerticesVisibles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="36" Height="36"
                                  MouseDown="Vertice_MouseDown"
                                  MouseMove="Vertice_MouseMove"
                                  MouseUp="Vertice_MouseUp"
                                  Cursor="Hand"
                                  Background="Transparent">
                                <Ellipse Fill="#0086BE" Stroke="White" StrokeThickness="2.5" Margin="3" />
                                <TextBlock Text="{Binding NumVertice}"
                                           Foreground="White" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Line x:Name="tempLine" Stroke="#0086BE" StrokeThickness="2"
                      StrokeDashArray="4,3" Visibility="Collapsed"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Background="#F0F0F0" Padding="5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding CantidadVertices, StringFormat=V: {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding CantidadAristas, StringFormat=A: {0}}" />
            </StatusBarItem>

            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="lblZoomStatus">Zoom: 100%</TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
